{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://cadence-api-4gni.onrender.com/api/:path*" },
    {
      "source": "/((?!assets/|fonts/|videos/|favicon.svg|sw.js|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
