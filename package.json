{
  "name": "bakery-model",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:client": "pnpm --filter @repo/client dev",
    "build:api": "pnpm --filter @repo/api build",
    "build:client": "pnpm --filter @repo/client build",
    "build": "pnpm run build:api && pnpm run build:client",
    "start:api": "pnpm --filter @repo/api start",
    "start:client": "pnpm --filter @repo/client preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
