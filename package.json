{
  "name": "bakery-model",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:marketing": "pnpm --filter @repo/marketing dev",
    "dev:app": "pnpm --filter @repo/app dev",
    "build:api": "pnpm --filter @repo/api build",
    "build:app": "pnpm --filter @repo/app build",
    "build:marketing": "pnpm --filter @repo/marketing build",
    "build": "pnpm run build:api && pnpm run build:app && pnpm run build:marketing",
    "start:api": "pnpm --filter @repo/api start",
    "start:app": "pnpm --filter @repo/app preview",
    "start:marketing": "pnpm --filter @repo/marketing preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
